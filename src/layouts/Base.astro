---
// Rangka semua halaman: jalur atas, kepala dengan menu, hebahan segera dan kaki laman.
// Menu dan butiran hubungan bertukar mengikut unit (akademi atau SRAIB).
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource-variable/open-sans/wght.css';
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { T, NAMA, MENU_UTAMA, href, asset, type Lang } from '../lib/i18n';
import { LAJUR_PROFIL, MEDIA, bahagianSraib, type Pautan } from '../lib/menu';

interface Props {
  lang: Lang;
  /** Laluan tanpa awalan bahasa, cth. 'sraib/profil'. Kosong untuk laman utama. */
  path: string;
  title: string;
  description?: string;
  /** Gambar pratonton apabila pautan dikongsi (laluan seperti '/images/uploads/x.jpg'). Lalai: gambar umum laman. */
  image?: string;
}

const { lang, path, title, description, image } = Astro.props;
const t = T[lang];
const lain: Lang = lang === 'ms' ? 'en' : 'ms';
const unit = path === 'sraib' || path.startsWith('sraib/') ? 'sraib' : 'akademi';
// Gambar pratonton lalai: satu untuk akademi, satu untuk SRAIB (dengan lencana sekolah).
const gambarKongsi = new URL(asset(image ?? (unit === 'sraib' ? 'images/kongsi-sraib.jpg' : 'images/kongsi.jpg')), Astro.site).toString();
const tetapan = (await getEntry('tetapan', 'laman'))!.data;
const hubungan = unit === 'sraib' ? tetapan.sraib : tetapan.akademi;
const media = [
  ['Facebook', hubungan.facebook],
  ['Instagram', hubungan.instagram],
  ['TikTok', hubungan.tiktok],
].filter(([, url]) => url) as [string, string][];

const namaUnit = unit === 'sraib' ? NAMA.sraibPendek : NAMA.akademi;
const tajukPenuh = title === NAMA.akademi ? title : `${title} | ${namaUnit}`;
const kanonik = new URL(href(lang, path), Astro.site).toString();
const tiadaHalaman = path === '404';
// Alamat prototaip (cth. github.io) tidak patut muncul dalam Google; hanya domain sebenar yang diindeks.
const hos = Astro.site?.hostname ?? '';
const prototaip = !(hos === 'irsyadbalok.com.my' || hos.endsWith('.irsyadbalok.com.my'));
const aktif = unit === 'sraib' ? bahagianSraib(path) : '';
const semasaHab = (p: string) => path === p || (p !== '' && path.startsWith(p.split('/')[0] + '/'));
const ke = (p: Pautan) => href(lang, p.path) + (p.hash ? `#${p.hash[lang]}` : '');

const hebahan = tetapan.hebahan;
const hebahanAktif = hebahan.aktif && hebahan.teks && (!hebahan.tamat || hebahan.tamat.getTime() >= Date.now() - 864e5);
const teksHebahan = lang === 'en' && hebahan.teks_en ? hebahan.teks_en : hebahan.teks;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tajukPenuh}</title>
    {description && <meta name="description" content={description} />}
    {(prototaip || tiadaHalaman) && <meta name="robots" content="noindex" />}
    {
      !tiadaHalaman && (
        <>
          <link rel="canonical" href={kanonik} />
          <link rel="alternate" hreflang="ms" href={new URL(href('ms', path), Astro.site).toString()} />
          <link rel="alternate" hreflang="en" href={new URL(href('en', path), Astro.site).toString()} />
        </>
      )
    }
    <link rel="icon" type="image/png" href={asset('favicon.png')} />
    <meta property="og:title" content={tajukPenuh} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAMA.akademi} />
    <meta property="og:locale" content={lang === 'ms' ? 'ms_MY' : 'en_MY'} />
    {!tiadaHalaman && <meta property="og:url" content={kanonik} />}
    <meta property="og:image" content={gambarKongsi} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0e6b38" />
    <!-- Tanpa JavaScript, menu dipaparkan terbuka sepenuhnya dan laman tetap boleh digunakan. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="langkau" href="#kandungan">{t.langkau}</a>

    <header>
    {
      hebahanAktif && (
        <div class="hebahan" role="status">
          <div class="bungkus">
            <p>{teksHebahan}</p>
          </div>
        </div>
      )
    }

    <div class="jalur-atas">
      <div class="bungkus">
        <a href={href(lang)}>{NAMA.akademi}</a>
        <a href={href(lain, tiadaHalaman ? '' : path)} lang={lain} hreflang={lain} aria-label={t.bahasaLainLabel}>{t.bahasaLain}</a>
      </div>
    </div>

    <div class="kepala">
      <div class="bungkus kepala-baris">
        <a class="jenama" href={href(lang, unit === 'sraib' ? 'sraib' : '')}>
          <img src={asset('images/logo-sraib-telus.webp')} alt="" width="360" height="415" />
          <span>{namaUnit}</span>
        </a>
        <button class="menu-butang" type="button" aria-expanded="false" aria-controls="menu-utama">{t.menu}</button>
        <nav id="menu-utama" aria-label={unit === 'sraib' ? t.menuBahagian : t.menuUtama}>
          {
            unit === 'akademi' ? (
              <ul class="menu">
                {MENU_UTAMA.map((m) =>
                  m.sub ? (
                    <li class="ada-sub">
                      <button class="sub-butang" type="button" aria-expanded="false" aria-controls={`sub-${m.path}`} aria-current={semasaHab(m.path) ? 'true' : undefined}>
                        {m[lang]}
                        <svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      </button>
                      <div class="sub" id={`sub-${m.path}`}>
                        <ul>
                          {m.sub.map((s) => (
                            <li><a href={href(lang, s.path)} aria-current={path === s.path ? 'page' : undefined}>{s[lang]}</a></li>
                          ))}
                        </ul>
                      </div>
                    </li>
                  ) : (
                    <li>
                      <a href={href(lang, m.path)} aria-current={semasaHab(m.path) ? 'page' : undefined}>
                        {m[lang]}
                      </a>
                    </li>
                  ),
                )}
              </ul>
            ) : (
              <ul class="menu">
                <li>
                  <a href={href(lang, 'sraib')} aria-current={aktif === 'utama' ? 'page' : undefined}>{t.utama}</a>
                </li>
                <li class="ada-sub lebar">
                  {/* Butang, bukan pautan: menekan "Profil" membuka senarai. Halaman profil ada dalam senarai itu. */}
                  <button class="sub-butang" type="button" aria-expanded="false" aria-controls="sub-profil" aria-current={aktif === 'profil' ? 'true' : undefined}>
                    {t.profil}
                    <svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </button>
                  <div class="sub lajur" id="sub-profil">
                    {LAJUR_PROFIL.map((l) => (
                      <div>
                        <a class="sub-tajuk" href={href(lang, l.path)}>{l.tajuk[lang]}</a>
                        <ul>
                          {l.pautan.map((p) => (
                            <li><a href={ke(p)}>{p[lang]}</a></li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </li>
                <li class="ada-sub">
                  <button class="sub-butang" type="button" aria-expanded="false" aria-controls="sub-media" aria-current={aktif === 'media' ? 'true' : undefined}>
                    Media
                    <svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </button>
                  <div class="sub" id="sub-media">
                    <ul>
                      {MEDIA.map((p) => (
                        <li><a href={ke(p)}>{p[lang]}</a></li>
                      ))}
                      {media.map(([nama, url]) => (
                        <li><a href={url} rel="noopener">{nama}</a></li>
                      ))}
                    </ul>
                  </div>
                </li>
                <li>
                  <a href={href(lang, 'hubungi')}>{t.hubungiPendek}</a>
                </li>
                <li class="telefon-sahaja">
                  <a href={href(lang, 'sraib/pendaftaran')} aria-current={path === 'sraib/pendaftaran' ? 'page' : undefined}>{t.daftar}</a>
                </li>
              </ul>
            )
          }
        </nav>
        {unit === 'sraib' && <a class="butang kecil" href={href(lang, 'sraib/pendaftaran')}>{t.daftarPendek}</a>}
      </div>
    </div>
    </header>

    <main id="kandungan">
      <slot />
    </main>

    <footer class="kaki">
      <div class="bungkus">
        <div class="kaki-grid">
          <div>
            <h2>{unit === 'sraib' ? NAMA.sraib : NAMA.akademi}</h2>
            <address>
              {tetapan.alamat.map((baris) => <>{baris}<br /></>)}
              {hubungan.telefon && <>{t.telefon}: <a href={`tel:${hubungan.telefon.replace(/[^0-9+]/g, '')}`}>{hubungan.telefon}</a><br /></>}
              {hubungan.emel && <>{t.emel}: <a href={`mailto:${hubungan.emel}`}>{hubungan.emel}</a></>}
            </address>
          </div>
          <div>
            <h2>{t.pautanPantas}</h2>
            <ul>
              <li><a href={tetapan.pautan.pendaftaran} rel="noopener">{t.pendaftaran}</a></li>
              <li><a href={tetapan.pautan.ibu_bapa} rel="noopener">{t.ibuBapa}</a></li>
              <li><a href={tetapan.pautan.staf} rel="noopener">{t.staf}</a></li>
              <li><a href={href(lang, 'hubungi')}>{t.hubungi}</a></li>
            </ul>
          </div>
          {
            media.length > 0 && (
              <div>
                <h2>{t.mediaSosial}</h2>
                <ul>
                  {media.map(([nama, url]) => (
                    <li><a href={url} rel="noopener">{nama}</a></li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
        <div class="kaki-bawah">
          <span>{t.hakCipta} © {new Date().getFullYear()} {NAMA.akademi}</span>
          <a href={href(lang, 'notis-privasi')}>{t.notisPrivasi}</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const nav = document.getElementById('menu-utama');
        const butangMenu = document.querySelector('.menu-butang');
        const butangSub = [...document.querySelectorAll('.sub-butang')];
        const tutupSub = () =>
          butangSub.forEach((b) => {
            b.setAttribute('aria-expanded', 'false');
            document.getElementById(b.getAttribute('aria-controls')).classList.remove('buka');
          });
        butangMenu?.addEventListener('click', () => {
          butangMenu.setAttribute('aria-expanded', String(nav.classList.toggle('buka')));
        });
        butangSub.forEach((b) =>
          b.addEventListener('click', () => {
            const buka = b.getAttribute('aria-expanded') !== 'true';
            tutupSub();
            b.setAttribute('aria-expanded', String(buka));
            document.getElementById(b.getAttribute('aria-controls')).classList.toggle('buka', buka);
          }),
        );
        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          tutupSub();
          if (document.activeElement?.closest('.ada-sub')) document.activeElement.blur();
        });
        document.addEventListener('click', (e) => !e.target.closest('.ada-sub') && tutupSub());
      })();
    </script>
  </body>
</html>
