---
// Senarai berita. skop "sraib": berita SRAIB dan berita akademi (laman SRAIB).
// skop "akademi": halaman /berita/ di hab, iaitu semua berita daripada akademi dan setiap unit, berlabel.
import Base from '../layouts/Base.astro';
import { T, UNIT, href, tarikh, type Lang } from '../lib/i18n';
import { beritaTerbit, laluanBerita, tajukBerita, ringkasanBerita } from '../lib/kandungan';

interface Props {
  lang: Lang;
  skop: 'sraib' | 'akademi';
}
const { lang, skop } = Astro.props;
const t = T[lang];
const akademi = skop === 'akademi';
const berita = await beritaTerbit(akademi ? undefined : ['sraib', 'akademi']);
const tajuk = akademi ? (lang === 'ms' ? 'Berita' : 'News') : lang === 'ms' ? 'Berita dan pengumuman' : 'News and announcements';
const ringkasan = akademi
  ? lang === 'ms'
    ? 'Berita daripada akademi dan setiap unit (SRAIB, SMAIB, TATIB), terbaharu dahulu.'
    : 'News from the academy and each unit (SRAIB, SMAIB, TATIB), newest first.'
  : lang === 'ms'
    ? 'Berita SRAIB dan pengumuman peringkat akademi, terbaharu dahulu.'
    : 'SRAIB news and academy-wide announcements, newest first.';
---

<Base lang={lang} path={akademi ? 'berita' : 'sraib/berita'} title={tajuk} description={ringkasan}>
  <div class="tajuk-halaman">
    <div class="bungkus">
      <h1>{tajuk}</h1>
      <p>{ringkasan}</p>
    </div>
  </div>
  <div class="bahagian">
    <div class="bungkus">
      {
        berita.length === 0 ? (
          <p>{t.tiadaBerita}</p>
        ) : (
          <ul class="senarai lebar">
            {berita.map((b) => (
              <li>
                <time datetime={b.data.tarikh.toISOString().slice(0, 10)}>{tarikh(b.data.tarikh, lang)}</time>
                <div>
                  <h2 style="font-size: 1.3rem; margin: 0 0 0.2rem;">
                    {/* Di hab setiap berita berlabel unitnya; dalam senarai SRAIB hanya berita akademi ditandakan. */}
                    {(akademi || b.data.unit === 'akademi') && <span class="tag-unit">{UNIT[b.data.unit]}</span>}
                    <a href={href(lang, laluanBerita(b))}>{tajukBerita(b, lang)}</a>
                  </h2>
                  <p>{ringkasanBerita(b, lang)}</p>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</Base>
