---
// Laman utama SRAIB. Sengaja ringkas: setiap bahagian membawa pelawat ke halaman lain untuk butiran.
import Base from '../layouts/Base.astro';
import { T, NAMA, href, asset, tarikh, julat, type Lang } from '../lib/i18n';
import { beritaTerbit, tajukBerita, acaraTakwim, tetapanLaman } from '../lib/kandungan';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = T[lang];
const tetapan = await tetapanLaman();
const gambar = tetapan.sraib.gambar_utama;
const berita = (await beritaTerbit(['sraib', 'akademi'])).slice(0, 3);

// Acara yang belum tamat pada hari laman dibina. Laman dibina semula setiap minggu (lihat deploy.yml).
const hariIni = Date.now() - 864e5;
const acara = (await acaraTakwim(['sraib', 'akademi'])).filter((a) => (a.tamat ?? a.mula).getTime() >= hariIni).slice(0, 3);

const teks = {
  ms: {
    pengenalan: 'Sekolah Rendah Islam Al-Irsyad Balok, Kuantan, sejak tahun 2000. Akhlak didahulukan, kurikulum kebangsaan dan pengajian agama berjalan bersama.',
    butiran: [
      ['Kod sekolah (KPM)', 'CYR4003'],
      ['Kod pendaftaran sekolah', 'CJAE004'],
      ['Jabatan Agama Islam Pahang', 'KS 0175/03'],
      ['Guru pada 2026', '69 orang'],
    ],
    mengapa: 'Mengapa SRAIB',
    jubin: [
      ['sraib/tarbiyah', 'Akhlak dahulu', 'Al-Quran, pra tahfiz, kerohanian, surau dan Imam Muda.'],
      ['sraib/kurikulum', 'Dua kurikulum', 'KSSR penuh bersama KAFA, Bahasa Arab, Jawi dan UPKK.'],
      ['sraib/kokurikulum', 'Kehidupan sekolah', 'Badan beruniform, kelab, sukan dan rumah sukan.'],
      ['sraib/sejarah', 'Dibina oleh masyarakat', 'Daripada 25 orang murid kepada sebuah sekolah di atas tanah wakaf.'],
    ],
    petikan: 'Setelah warga SRAIB mengenali penciptaNya akan terbentuk adab yang elok seiring dengan kecerdasan minda.',
    penulis: 'Salmah binti Mat Yusoff, Guru Besar',
    desc: 'Sekolah Rendah Islam Al-Irsyad Balok (SRAIB), Kuantan: pendaftaran, kurikulum, kokurikulum, takwim dan berita sekolah.',
  },
  en: {
    pengenalan: 'Sekolah Rendah Islam Al-Irsyad Balok, Kuantan, since 2000. Character comes first, and the national curriculum and religious studies run side by side.',
    butiran: [
      ['School code (Ministry of Education)', 'CYR4003'],
      ['School registration code', 'CJAE004'],
      ['Pahang Islamic Religious Department', 'KS 0175/03'],
      ['Teachers in 2026', '69'],
    ],
    mengapa: 'Why SRAIB',
    jubin: [
      ['sraib/tarbiyah', 'Character first', 'Al-Quran, pre-tahfiz, spiritual life, surau and Imam Muda.'],
      ['sraib/kurikulum', 'Two curricula', 'Full KSSR with KAFA, Arabic, Jawi and UPKK.'],
      ['sraib/kokurikulum', 'School life', 'Uniformed bodies, clubs, sports and sports houses.'],
      ['sraib/sejarah', 'Built by the community', 'From 25 pupils to a school on waqf land.'],
    ],
    petikan: 'Once the SRAIB community knows its Creator, good manners will take shape alongside a sharp mind.',
    penulis: 'Salmah binti Mat Yusoff, Headmistress',
    desc: 'Sekolah Rendah Islam Al-Irsyad Balok (SRAIB), Kuantan: admission, curriculum, co-curriculum, calendar and school news.',
  },
}[lang];
---

<Base lang={lang} path="sraib" title={NAMA.sraib} description={teks.desc}>
  <section class:list={['pembuka', gambar && 'bergambar']}>
    {gambar && <img class="pembuka-gambar" src={asset(gambar)} alt={tetapan.sraib.gambar_utama_alt ?? ''} />}
    {!gambar && <img class="pembuka-lencana" src={asset('images/logo-sraib-telus.webp')} alt="" width="360" height="415" />}
    <div class="bungkus pembuka-isi">
      <div class="pembuka-teks">
        <h1>{NAMA.moto}</h1>
        <p>{teks.pengenalan}</p>
        <div class="butang-baris">
          <a class="butang" href={href(lang, 'sraib/pendaftaran')}>{t.daftar}</a>
          <a class="butang kedua" href={href(lang, 'hubungi')}>{t.kerjasama}</a>
        </div>
      </div>
    </div>
  </section>
  <div class="jalur" aria-hidden="true"></div>

  <div class="butiran">
    <dl class="bungkus">
      {
        teks.butiran.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <section class="bahagian" aria-labelledby="tajuk-mengapa">
    <div class="bungkus">
      <div class="kepala-bahagian">
        <h2 id="tajuk-mengapa">{teks.mengapa}</h2>
        <a href={href(lang, 'sraib/profil')}>{lang === 'ms' ? 'Profil sekolah' : 'School profile'}</a>
      </div>
      <ul class="jubin empat">
        {
          teks.jubin.map(([p, tajuk, kecil]) => (
            <li>
              <a href={href(lang, p)}>
                <strong>{tajuk}</strong>
                <span>{kecil}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bahagian langit petikan" aria-labelledby="tajuk-tinta">
    <div class="bungkus">
      <h2 id="tajuk-tinta">Tinta Guru Besar</h2>
      <blockquote lang={lang}>{teks.petikan}</blockquote>
      <p>
        <cite>{teks.penulis}</cite>
      </p>
      <a href={href(lang, 'sraib/tinta-guru-besar')}>{t.bacaPenuh}</a>
    </div>
  </section>

  <section class="bahagian">
    <div class="bungkus dua-lajur">
      <div>
        <div class="kepala-bahagian">
          <h2>{t.acaraAkanDatang}</h2>
          <a href={href(lang, 'sraib/takwim')}>{t.takwimPenuh}</a>
        </div>
        {
          acara.length === 0 ? (
            <p>{t.tiadaAcara}</p>
          ) : (
            <ul class="senarai">
              {acara.map((a) => (
                <li>
                  <span class="bila">{julat(a.mula, a.tamat, lang)} {a.mula.getUTCFullYear()}</span>
                  <span>{lang === 'en' && a.tajuk_en ? a.tajuk_en : a.tajuk}</span>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <div>
        <div class="kepala-bahagian">
          <h2>{t.beritaTerkini}</h2>
          <a href={href(lang, 'sraib/berita')}>{t.semuaBerita}</a>
        </div>
        {
          berita.length === 0 ? (
            <p>{t.tiadaBerita}</p>
          ) : (
            <ul class="senarai">
              {berita.map((b) => (
                <li>
                  <time datetime={b.data.tarikh.toISOString().slice(0, 10)}>{tarikh(b.data.tarikh, lang)}</time>
                  <a href={href(lang, `sraib/berita/${b.id}`)}>{tajukBerita(b, lang)}</a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </section>
</Base>
