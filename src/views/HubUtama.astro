---
// Laman utama akademi (hab): pilih unit, pautan pantas dan berita terkini.
import Base from '../layouts/Base.astro';
import { T, NAMA, UNIT, href, asset, tarikh, type Lang } from '../lib/i18n';
import { beritaTerbit, laluanBerita, tajukBerita, tetapanLaman } from '../lib/kandungan';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = T[lang];
const tetapan = await tetapanLaman();
const gambar = tetapan.akademi.gambar_utama;
const berita = (await beritaTerbit()).slice(0, 3);

const teks = {
  ms: {
    visi: 'Menjadi peneraju sistem pendidikan Islam yang menyeluruh, terunggul dan dihormati untuk membentuk tokoh dan masyarakat yang Rabbani.',
    huraian: 'Akademi ini menaungi tiga institusi di Kampung Chengal Lempong, Kuantan. Pilih gerbang untuk masuk ke laman setiap unit.',
    sraib: 'Sekolah rendah',
    smaib: 'Sekolah menengah',
    tatib: 'Tahfiz',
    daftarKecil: 'Borang dalam talian dan semakan status',
    ibuBapaKecil: 'Untuk ibu bapa murid sedia ada',
    stafKecil: 'Untuk guru dan kakitangan',
    desc: 'Laman rasmi Akademi Pendidikan Irsyad Balok, Kuantan: Sekolah Rendah Islam Al-Irsyad Balok (SRAIB), SMAIB dan TATIB.',
  },
  en: {
    visi: 'To lead a comprehensive, outstanding and respected system of Islamic education that shapes Rabbani leaders and a Rabbani community.',
    huraian: 'The academy is home to three institutions in Kampung Chengal Lempong, Kuantan. Choose a gateway to enter each unit’s site.',
    sraib: 'Primary school',
    smaib: 'Secondary school',
    tatib: 'Tahfiz',
    daftarKecil: 'Online form and status check',
    ibuBapaKecil: 'For parents of current pupils',
    stafKecil: 'For teachers and staff',
    desc: 'Official site of Akademi Pendidikan Irsyad Balok, Kuantan: Sekolah Rendah Islam Al-Irsyad Balok (SRAIB), SMAIB and TATIB.',
  },
}[lang];
---

<Base lang={lang} path="" title={NAMA.akademi} description={teks.desc}>
  <section class:list={['pembuka', gambar && 'bergambar']}>
    {gambar && <img class="pembuka-gambar" src={asset(gambar)} alt={tetapan.akademi.gambar_utama_alt ?? ''} />}
    <div class="bungkus pembuka-isi">
      <div class="pembuka-teks" style="max-width: 44rem;">
        <h1>{NAMA.akademi}</h1>
        <p>{teks.visi}</p>
      </div>
    </div>
  </section>

  <section class="bahagian" aria-labelledby="tajuk-unit">
    <div class="bungkus">
      <div class="kepala-bahagian">
        <h2 id="tajuk-unit">{t.tigaUnit}</h2>
      </div>
      <p style="max-width: 44rem; margin: 0;">{teks.huraian}</p>
      <ul class="tiga-gerbang">
        <li>
          <a href={href(lang, 'sraib')}>
            <div class="gerbang">
              <div class="gerbang-dalam">
                <img class="gerbang-logo" src={asset('images/logo-sraib-telus.webp')} alt="" width="360" height="414" />
                <strong>SRAIB</strong>
                <span>{teks.sraib}</span>
              </div>
            </div>
          </a>
          <p class="bawah"><a href={href(lang, 'sraib')}>{t.masuk}</a></p>
        </li>
        <li>
          <div class="gerbang senyap">
            <div class="gerbang-dalam">
              <img class="gerbang-logo" src={asset('images/logo-smaib.webp')} alt="" width="368" height="415" />
                <strong>SMAIB</strong>
              <span>{teks.smaib}</span>
            </div>
          </div>
          <p class="bawah">{t.akanMenyusul}</p>
        </li>
        <li>
          <div class="gerbang senyap">
            <div class="gerbang-dalam">
              <img class="gerbang-logo" src={asset('images/logo-tatib.webp')} alt="" width="258" height="415" />
                <strong>TATIB</strong>
              <span>{teks.tatib}</span>
            </div>
          </div>
          <p class="bawah">{t.akanMenyusul}</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="bahagian lembut" aria-labelledby="tajuk-pautan">
    <div class="bungkus">
      <div class="kepala-bahagian">
        <h2 id="tajuk-pautan">{t.pautanPantas}</h2>
      </div>
      <ul class="jubin">
        <li>
          <a href={tetapan.pautan.pendaftaran} rel="noopener"><strong>{t.pendaftaran}</strong><span>{teks.daftarKecil}</span></a>
        </li>
        <li>
          <a href={tetapan.pautan.ibu_bapa} rel="noopener"><strong>{t.ibuBapa}</strong><span>{teks.ibuBapaKecil}</span></a>
        </li>
        <li>
          <a href={tetapan.pautan.staf} rel="noopener"><strong>{t.staf}</strong><span>{teks.stafKecil}</span></a>
        </li>
      </ul>
    </div>
  </section>

  <section class="bahagian" aria-labelledby="tajuk-berita">
    <div class="bungkus">
      <div class="kepala-bahagian">
        <h2 id="tajuk-berita">{t.beritaTerkini}</h2>
        <a href={href(lang, 'berita')}>{t.semuaBerita}</a>
      </div>
      {
        berita.length === 0 ? (
          <p>{t.tiadaBerita}</p>
        ) : (
          <ul class="senarai lebar">
            {berita.map((b) => (
              <li>
                <time datetime={b.data.tarikh.toISOString().slice(0, 10)}>{tarikh(b.data.tarikh, lang)}</time>
                {/* Tiga berita terbaharu daripada semua unit; tanda menunjukkan unit asalnya. */}
                <div>
                  <span class="tag-unit">{UNIT[b.data.unit]}</span>
                  <a href={href(lang, laluanBerita(b))}>{tajukBerita(b, lang)}</a>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>
