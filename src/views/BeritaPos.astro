---
// Satu berita. Isi ditulis dalam BM; tajuk dan ringkasan boleh ada versi Inggeris.
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { T, href, asset, tarikh, type Lang } from '../lib/i18n';
import { tajukBerita, ringkasanBerita } from '../lib/kandungan';
import { butangPautan, failPdf } from '../lib/pautan';

interface Props {
  lang: Lang;
  id: string;
}
const { lang, id } = Astro.props;
const t = T[lang];
const pos = (await getEntry('berita', id))!;
const { Content } = await render(pos);
const d = pos.data;
const foto = d.gambar;
const alt = d.gambar_alt ?? '';
const pautan = butangPautan(d.pautan, lang, id);
const pdf = failPdf(d.pdf);
// Teks alt: gambar utama memakai keterangan penuh; gambar lain ditambah nombor supaya berbeza.
const altFoto = (i: number) => (i === 0 ? alt : `${alt} (${i + 1})`);
---

<Base lang={lang} path={`sraib/berita/${id}`} title={tajukBerita(pos, lang)} description={ringkasanBerita(pos, lang)}>
  <article>
    <div class="tajuk-halaman">
      <div class="bungkus">
        <p style="margin: 0 0 0.5rem; font-size: 1rem;">
          <time datetime={d.tarikh.toISOString().slice(0, 10)}>{tarikh(d.tarikh, lang)}</time>
        </p>
        <h1>{tajukBerita(pos, lang)}</h1>
        <p>{ringkasanBerita(pos, lang)}</p>
      </div>
    </div>
    <div class="bahagian">
      <div class="bungkus">
        {lang === 'en' && <p class="nota biru">{t.bmSahaja}</p>}
        {/* Susunan dalam kod ialah susunan pada telefon: gambar utama, isi, gambar lain.
            Pada skrin lebar, CSS (.pos) menyusun gambar sebagai mozek di atas isi. */}
        <div class:list={['pos', `pos-${foto.length}`]}>
          {
            foto[0] && (
              <a class="pos-bingkai pos-utama" href={asset(foto[0])} title={t.lihatGambar}>
                <img src={asset(foto[0])} alt={altFoto(0)} />
              </a>
            )
          }
          <div class="pos-isi">
            <div class="prosa" lang="ms">
              <Content />
            </div>
            {
              (pdf || pautan.length > 0) && (
                <div class="butang-baris pos-butang">
                  {pdf && (
                    <a class="butang kedua" href={asset(pdf)} download>
                      {d.pdf_label?.trim() || t.muatTurunPdf}
                    </a>
                  )}
                  {pautan.map((p) => (
                    <a class="butang kedua" href={p.url} rel="noopener">
                      {p.teks}
                      <span class="pos-luar" aria-hidden="true">&#8599;</span>
                    </a>
                  ))}
                </div>
              )
            }
          </div>
          {
            foto.length > 1 && (
              <div class="pos-lain">
                {foto.slice(1).map((f, i) => (
                  <a class="pos-bingkai" href={asset(f)} title={t.lihatGambar}>
                    <img src={asset(f)} alt={altFoto(i + 1)} loading="lazy" />
                  </a>
                ))}
              </div>
            )
          }
        </div>
        <p class="meta-halaman">
          <a href={href(lang, 'sraib/berita')}>{t.semuaBerita}</a>
        </p>
        {/* Gambar besar di atas halaman yang sama. Tanpa JavaScript, pautan gambar membuka fail gambar seperti biasa. */}
        {
          foto.length > 0 && (
            <dialog class="peti" id="peti-gambar" aria-label={t.gambarPenuh}>
              <img alt="" />
              <button type="button" class="peti-tutup" aria-label={t.tutup}>
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
              {foto.length > 1 && (
                <>
                  <button type="button" class="peti-sebelum" aria-label={t.gambarSebelum}>
                    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </button>
                  <button type="button" class="peti-seterusnya" aria-label={t.gambarSeterusnya}>
                    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </button>
                </>
              )}
            </dialog>
          )
        }
      </div>
    </div>
  </article>
</Base>

<script is:inline>
  (() => {
    const peti = document.getElementById('peti-gambar');
    if (!peti || !peti.showModal) return;
    const besar = peti.querySelector('img');
    const bingkai = [...document.querySelectorAll('.pos-bingkai')];
    let semasa = 0;
    const tunjuk = (n) => {
      semasa = (n + bingkai.length) % bingkai.length;
      besar.src = bingkai[semasa].href;
      besar.alt = bingkai[semasa].querySelector('img').alt;
    };
    bingkai.forEach((a, n) =>
      a.addEventListener('click', (e) => {
        if (e.ctrlKey || e.metaKey || e.shiftKey) return; // buka dalam tab baharu seperti biasa
        e.preventDefault();
        tunjuk(n);
        peti.showModal();
      }),
    );
    peti.querySelector('.peti-tutup').addEventListener('click', () => peti.close());
    peti.querySelector('.peti-sebelum')?.addEventListener('click', () => tunjuk(semasa - 1));
    peti.querySelector('.peti-seterusnya')?.addEventListener('click', () => tunjuk(semasa + 1));
    // Menekan kawasan gelap di luar gambar menutup paparan. Esc menutupnya secara terbina dalam.
    peti.addEventListener('click', (e) => e.target === peti && peti.close());
    peti.addEventListener('keydown', (e) => {
      if (bingkai.length < 2) return;
      if (e.key === 'ArrowLeft') tunjuk(semasa - 1);
      if (e.key === 'ArrowRight') tunjuk(semasa + 1);
    });
  })();
</script>
