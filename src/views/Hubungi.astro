---
// Hubungi kami. Semua butiran datang daripada src/content/tetapan/laman.yaml.
// Setiap unit dipaparkan dalam jadual sendiri; unit tanpa butiran tidak dipaparkan.
import Base from '../layouts/Base.astro';
import { T, NAMA, type Lang } from '../lib/i18n';
import { tetapanLaman } from '../lib/kandungan';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = T[lang];
const s = await tetapanLaman();
const tajuk = lang === 'ms' ? 'Hubungi kami' : 'Contact us';
const ringkasan = lang === 'ms' ? 'Alamat, telefon, e-mel dan media sosial.' : 'Address, telephone, e-mail and social media.';
const peta = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(NAMA.sraib + ', Kuantan, Pahang')}`;

const unit = [
  { nama: NAMA.sraib, h: s.sraib },
  { nama: NAMA.akademi, h: s.akademi },
].filter((u) => u.h.telefon || u.h.emel || u.h.facebook || u.h.instagram || u.h.tiktok);
---

<Base lang={lang} path="hubungi" title={tajuk} description={ringkasan}>
  <div class="tajuk-halaman">
    <div class="bungkus">
      <h1>{tajuk}</h1>
      <p>{ringkasan}</p>
    </div>
  </div>
  <div class="bahagian">
    <div class="bungkus">
      <div class="prosa">
        <h2>{t.alamat}</h2>
        <p>
          {s.alamat.map((baris) => <>{baris}<br /></>)}
          <a href={peta} rel="noopener">{t.bukaPeta}</a>
        </p>
        {s.waktu_pejabat && <p>{lang === 'ms' ? 'Waktu pejabat' : 'Office hours'}: {s.waktu_pejabat}</p>}

        {
          unit.map((u) => (
            <>
              <h2>{u.nama}</h2>
              <table>
                <tbody>
                  {u.h.telefon && (
                    <tr>
                      <td>{t.telefon}</td>
                      <td><a href={`tel:${u.h.telefon.replace(/[^0-9+]/g, '')}`}>{u.h.telefon}</a></td>
                    </tr>
                  )}
                  {u.h.emel && (
                    <tr>
                      <td>{t.emel}</td>
                      <td><a href={`mailto:${u.h.emel}`}>{u.h.emel}</a></td>
                    </tr>
                  )}
                  {(u.h.facebook || u.h.instagram || u.h.tiktok) && (
                    <tr>
                      <td>{t.mediaSosial}</td>
                      <td>
                        {u.h.facebook && <><a href={u.h.facebook} rel="noopener">Facebook</a><br /></>}
                        {u.h.instagram && <><a href={u.h.instagram} rel="noopener">Instagram</a><br /></>}
                        {u.h.tiktok && <a href={u.h.tiktok} rel="noopener">TikTok</a>}
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </>
          ))
        }
      </div>
    </div>
  </div>
</Base>
